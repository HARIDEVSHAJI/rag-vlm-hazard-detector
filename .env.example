# RAG-VLM Environment Variables Template
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# Groq API Configuration (Fast LLM Synthesis - Recommended)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic Claude API Configuration (Optional alternative LLM)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# RAGVLM_CLAUDE_MODEL=claude-sonnet-5

# Offline Mode (Optional: set to 1 to force offline fallback testing)
# RAGVLM_OFFLINE=0
