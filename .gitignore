# ==============================================================================
# Git Ignore Rules for RAG-VLM
# ==============================================================================

# --- Secrets & Environment Variables (CRITICAL: Never commit API keys) ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
lib/
include/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
sdist/
*.egg-info/
.installed.cfg
*.egg

# --- PyTorch / Hugging Face / Model Weights Cache ---
*.pt
*.pth
*.bin
*.safetensors
*.onnx
checkpoints/
model_weights/
.cache/

# --- Vector Database & Telemetry Cache ---
chroma_db/
.chroma/

# --- Operating System Junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
__MACOSX/

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Temporary Files & Logs ---
*.log
tmp/
temp/
